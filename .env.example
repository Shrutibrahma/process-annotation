# Engine: gemini (real analysis) or mock (synthetic steps, for testing the UI)
WORKSTUDY_ENGINE=gemini
GEMINI_API_KEY=your-key-here
# Model names change often; check https://ai.google.dev/gemini-api/docs/models
WORKSTUDY_GEMINI_MODEL=gemini-3.8-flash
# static = fixed fps over the whole video (recommended for step timing); agentic = model explores the timeline
WORKSTUDY_MEDIA_PROCESSING=static
# Frames per second sampled in static mode (Gemini default is 1).
# Lowered automatically for long videos so the request stays under WORKSTUDY_MAX_VIDEO_TOKENS.
WORKSTUDY_FPS=5
# ~258 tokens per frame: 600k tokens = about 8 min at 5 fps, 20 min at 2 fps. Also caps cost per study.
WORKSTUDY_MAX_VIDEO_TOKENS=600000
# 1 = tenths (4.9, 5.1), 0 = whole seconds like the paper forms
WORKSTUDY_SHEET_DECIMALS=1
WORKSTUDY_MAX_UPLOAD_MB=2048
# WORKSTUDY_DATA=C:\work-study-data
# Per-step transcripts: frames per second for each step clip, and parallel requests
WORKSTUDY_TRANSCRIPT_FPS=10
WORKSTUDY_TRANSCRIPT_WORKERS=4
# Copilot chat and Kaizen ideas (text only). Defaults to WORKSTUDY_GEMINI_MODEL.
# WORKSTUDY_COPILOT_MODEL=
# focused = Work chart + Step breakdown only; full = also instructions, time study, Kaizen, Copilot, line balancing
WORKSTUDY_UI=focused
# fine = elements like a time observation sheet (grab / place / drive); coarse = larger work-instruction steps
WORKSTUDY_STEP_DETAIL=fine
# Free alignment timing from marked reference cycles (needs onnxruntime). 0 turns it off.
WORKSTUDY_ALIGN=1
# Frames per second read for alignment (CPU cost grows with it)
WORKSTUDY_ALIGN_FPS=2
# Use alignment for an element only when its blind error on your marked cycles is at most this (s)
WORKSTUDY_ALIGN_MAX_ERR=1.0
# auto = per element the more accurate of Gemini and alignment; gemini or align forces one
WORKSTUDY_PREFER=auto
# Accounts and teams (on in the Docker image; off locally)
WORKSTUDY_AUTH=0
# Access code needed to start a new team (share it with the link). Empty = anyone with the link
# WORKSTUDY_SIGNUP_CODE=
# open or closed (closed = no new accounts)
WORKSTUDY_SIGNUP=open
# Paid video analyses per team per month
WORKSTUDY_MONTHLY_ANALYSES=30
# Signs login sessions; generated into DATA/.session-secret when empty
# WORKSTUDY_SECRET=
# Strongest model for the passes that decide accuracy: element timing per cycle, precision pass,
# reading sheet photos. Cycles, layout and transcripts stay on WORKSTUDY_GEMINI_MODEL.
# gemini-4-argon: best, ~3-4x the cost of Flash. Empty = use WORKSTUDY_GEMINI_MODEL everywhere.
WORKSTUDY_TIMING_MODEL=gemini-4-argon
# Frame detail for the precision pass: high (small bins and parts readable), medium or low
WORKSTUDY_REFINE_RESOLUTION=high
# Model for Teach, step descriptions and chat (text only, cents per message)
WORKSTUDY_COPILOT_MODEL=gemini-4-argon
